# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in keys.
# .env.local is git-ignored — never commit secrets.
# ──────────────────────────────────────────────

# ─── NOVA AI Assistant — LLM (optional) ───
# Routes chat through any OpenAI-compatible API.
# Without a key, the assistant uses its built-in local intelligence engine.
# VITE_AI_API_KEY=sk-your-api-key-here
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_MODEL=gpt-4o-mini

# ─── Sarvam AI Voice — STT + TTS (optional) ───
# Get a key at https://dashboard.sarvam.ai
# Enables Saarika speech-to-text and Bulbul text-to-speech.
# Without a key, voice falls back to the browser Web Speech API.
# VITE_SARVAM_API_KEY=your-sarvam-subscription-key
# VITE_SARVAM_TTS_SPEAKER=anushka
# VITE_SARVAM_LANGUAGE=en-IN
